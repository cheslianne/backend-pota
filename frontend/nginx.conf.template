server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Static assets
    location /assets/ {
        try_files $uri =404;
    }

    location /images/ {
        try_files $uri =404;
    }

    # Dashboards
    location /dashboards/ {
        try_files $uri $uri.html =404;
    }

    # Everything else: serve matching .html file, fall back to index.html
    location / {
        try_files $uri $uri.html /index.html;
    }
}

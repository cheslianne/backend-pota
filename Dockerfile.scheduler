FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV CMDSTAN_DIR=/opt/cmdstan
ENV CMDSTAN=/opt/cmdstan/cmdstan-2.33.1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Prophet needs a real CmdStan installation at runtime. Install a fixed,
# known-compatible version into an image path and fail the build if it is absent.
RUN python -c "import cmdstanpy; cmdstanpy.install_cmdstan(version='2.33.1', dir='/opt/cmdstan', verbose=True); print(cmdstanpy.cmdstan_path())"

COPY src ./src

CMD ["python", "-m", "src.etl_pipeline.scheduler"]
